{
  "result": "# \u65f6\u95f4\u7684\u6cb3\u6d41\u4e0e\u5cb8\u8fb9\u7684\u6211\u4eec\n\n\u6709\u65f6\u5019\u6211\u4f1a\u60f3\uff0c\u65f6\u95f4\u5230\u5e95\u662f\u4ec0\u4e48\u3002\n\n\u4e0d\u662f\u7269\u7406\u5b66\u610f\u4e49\u4e0a\u90a3\u4e2a\u53ef\u4ee5\u7528\u65b9\u7a0b\u5f0f\u63cf\u8ff0\u7684\u7ef4\u5ea6\uff0c\u800c\u662f\u6211\u4eec\u771f\u771f\u5207\u5207\u611f\u53d7\u5230\u7684\u3001\u6d41\u6dcc\u5728\u751f\u547d\u4e2d\u7684\u67d0\u79cd\u4e1c\u897f\u3002\u5b83\u50cf\u4e00\u6761\u6cb3\uff0c\u65e0\u58f0\u65e0\u606f\u5730\u5411\u524d\u5954\u6d8c\uff0c\u800c\u6211\u4eec\u7ad9\u5728\u5cb8\u8fb9\uff0c\u770b\u5b83\u5e26\u8d70\u4e86\u4ec0\u4e48\uff0c\u53c8\u7559\u4e0b\u4e86\u4ec0\u4e48\u3002\n\n\u5c0f\u65f6\u5019\uff0c\u65f6\u95f4\u8fc7\u5f97\u7279\u522b\u6162\u3002\u4e00\u4e2a\u4e0b\u5348\u53ef\u4ee5\u6f2b\u957f\u5f97\u50cf\u4e00\u8f88\u5b50\u3002\u6211\u4eec\u5728\u9633\u5149\u4e0b\u8ffd\u9010\u873b\u8713\uff0c\u5728\u96e8\u540e\u7684\u6c34\u6d3c\u91cc\u8e29\u6c34\uff0c\u770b\u8682\u8681\u642c\u5bb6\u4e00\u770b\u5c31\u662f\u4e00\u4e2a\u5c0f\u65f6\u3002\u90a3\u65f6\u5019\u6211\u4eec\u4e0d\u61c2\u4ec0\u4e48\u53eb\"\u73cd\u60dc\u5f53\u4e0b\"\uff0c\u56e0\u4e3a\u6211\u4eec\u672c\u8eab\u5c31\u662f\u5f53\u4e0b\u2014\u2014\u7eaf\u7cb9\u5730\u3001\u5b8c\u6574\u5730\u6d3b\u5728\u6bcf\u4e00\u4e2a\u77ac\u95f4\u91cc\uff0c\u4e0d\u9700\u8981\u63d0\u9192\uff0c\u4e0d\u9700\u8981\u7ec3\u4e60\u3002\n\n\u540e\u6765\u5462\uff1f\u540e\u6765\u65f6\u95f4\u5f00\u59cb\u52a0\u901f\u3002\n\n\u4e0a\u5b66\u3001\u8003\u8bd5\u3001\u6bd5\u4e1a\u3001\u5de5\u4f5c\u3001\u6210\u5bb6\u3002\u65e5\u5b50\u50cf\u662f\u88ab\u6309\u4e86\u5feb\u8fdb\u952e\uff0c\u4e00\u7728\u773c\u5341\u5e74\u5c31\u8fc7\u53bb\u4e86\u3002\u6211\u4eec\u5f00\u59cb\u611f\u53f9\"\u65f6\u95f4\u90fd\u53bb\u54ea\u513f\u4e86\"\uff0c\u5f00\u59cb\u5728\u751f\u65e5\u86cb\u7cd5\u524d\u8bb8\u613f\uff0c\u5e0c\u671b\u65f6\u95f4\u6162\u4e00\u70b9\u3002\u53ef\u65f6\u95f4\u4ece\u6765\u4e0d\u542c\u8bdd\u3002\u5b83\u6709\u81ea\u5df1\u7684\u8282\u594f\uff0c\u51b7\u9177\u800c\u516c\u5e73\uff0c\u5bf9\u6bcf\u4e2a\u4eba\u90fd\u4e00\u89c6\u540c\u4ec1\u3002\n\n\u6211\u5e38\u5e38\u60f3\u8d77\u4e00\u4e9b\u5f88\u5c0f\u7684\u77ac\u95f4\u3002\n\n\u5916\u516c\u5750\u5728\u85e4\u6905\u4e0a\uff0c\u624b\u91cc\u6367\u7740\u4e00\u676f\u70ed\u8336\uff0c\u8336\u9999\u6c24\u6c32\u3002\u4ed6\u772f\u7740\u773c\u775b\u770b\u7a97\u5916\u7684\u9633\u5149\uff0c\u5634\u89d2\u5e26\u7740\u6de1\u6de1\u7684\u7b11\u3002\u90a3\u65f6\u5019\u6211\u4e0d\u61c2\u4ed6\u5728\u7b11\u4ec0\u4e48\uff0c\u73b0\u5728\u60f3\u6765\uff0c\u4e5f\u8bb8\u4ed6\u53ea\u662f\u5728\u4eab\u53d7\u90a3\u4e00\u523b\u7684\u5b81\u9759\u2014\u2014\u6ca1\u6709\u70e6\u607c\uff0c\u6ca1\u6709\u7126\u8651\uff0c\u53ea\u6709\u9633\u5149\u3001\u8336\u9999\uff0c\u548c\u4e00\u9897\u5b89\u987f\u4e86\u7684\u5fc3\u3002\n\n\u6bcd\u4eb2\u5728\u53a8\u623f\u91cc\u5fd9\u788c\u7684\u80cc\u5f71\u3002\u9505\u7897\u74e2\u76c6\u7684\u78b0\u649e\u58f0\uff0c\u6cb9\u70df\u673a\u7684\u55e1\u55e1\u58f0\uff0c\u996d\u83dc\u7684\u9999\u6c14\u4ece\u95e8\u7f1d\u91cc\u98d8\u51fa\u6765\u3002\u90a3\u662f\u5bb6\u7684\u58f0\u97f3\uff0c\u662f\u5b89\u5168\u611f\u7684\u58f0\u97f3\u3002\u5e74\u5c11\u65f6\u89c9\u5f97\u5e73\u5e38\u5f97\u4e0d\u80fd\u518d\u5e73\u5e38\uff0c\u5982\u4eca\u5374\u6210\u4e86\u8bb0\u5fc6\u91cc\u6700\u6e29\u6696\u7684\u753b\u9762\u3002\n\n\u8fd8\u6709\u90a3\u4e9b\u548c\u670b\u53cb\u5728\u4e00\u8d77\u7684\u65e5\u5b50\u3002\u6211\u4eec\u5f7b\u591c\u957f\u8c08\uff0c\u804a\u7406\u60f3\uff0c\u804a\u672a\u6765\uff0c\u804a\u90a3\u4e9b\u9065\u4e0d\u53ef\u53ca\u7684\u68a6\u60f3\u3002\u6211\u4eec\u4ee5\u4e3a\u8fd9\u6837\u7684\u591c\u665a\u4f1a\u4e00\u76f4\u6301\u7eed\u4e0b\u53bb\uff0c\u4ee5\u4e3a\u53cb\u8c0a\u53ef\u4ee5\u8de8\u8d8a\u4e00\u5207\u3002\u540e\u6765\u5927\u5bb6\u5404\u5954\u4e1c\u897f\uff0c\u8054\u7cfb\u6e10\u6e10\u5c11\u4e86\uff0c\u4f46\u90a3\u4e9b\u591c\u665a\u7684\u6e29\u5ea6\uff0c\u59cb\u7ec8\u7559\u5728\u5fc3\u91cc\u3002\n\n\u8fd9\u4e9b\u77ac\u95f4\uff0c\u5f53\u65f6\u89c9\u5f97\u5fae\u4e0d\u8db3\u9053\uff0c\u56de\u5934\u770b\u5374\u95ea\u95ea\u53d1\u5149\u3002\n\n\u6211\u60f3\uff0c\u8fd9\u5c31\u662f\u65f6\u95f4\u6700\u5947\u5999\u7684\u5730\u65b9\u3002\u5b83\u628a\u666e\u901a\u7684\u65f6\u523b\u53d8\u6210\u73cd\u8d35\u7684\u8bb0\u5fc6\uff0c\u628a\u5e73\u6de1\u7684\u65e5\u5b50\u917f\u6210\u9187\u539a\u7684\u9152\u3002\u6211\u4eec\u603b\u662f\u5728\u5931\u53bb\u4e4b\u540e\u624d\u61c2\u5f97\u73cd\u60dc\uff0c\u603b\u662f\u5728\u56de\u671b\u7684\u65f6\u5019\u624d\u53d1\u73b0\u7f8e\u597d\u3002\n\n\u8fd9\u8ba9\u6211\u60f3\u5230\u4e00\u4e2a\u95ee\u9898\uff1a\u6211\u4eec\u7a76\u7adf\u5e94\u8be5\u600e\u6837\u6d3b\u7740\uff1f\n\n\u4e0d\u662f\u90a3\u4e9b\u5b8f\u5927\u7684\u54f2\u5b66\u547d\u9898\uff0c\u800c\u662f\u4e00\u4e2a\u5f88\u6734\u7d20\u7684\u95ee\u9898\u3002\u6211\u4eec\u6bcf\u5929\u90fd\u5728\u751f\u6d3b\uff0c\u53ef\u6211\u4eec\u771f\u7684\"\u6d3b\"\u7740\u5417\uff1f\u8fd8\u662f\u53ea\u662f\u5728\u673a\u68b0\u5730\u91cd\u590d\uff0c\u88ab\u5de5\u4f5c\u63a8\u7740\u8d70\uff0c\u88abdeadline\u8ffd\u7740\u8dd1\uff0c\u88ab\u624b\u673a\u5c4f\u5e55\u7ed1\u67b6\u4e86\u6ce8\u610f\u529b\uff1f\n\n\u6211\u89c1\u8fc7\u592a\u591a\u4eba\uff0c\u5305\u62ec\u6211\u81ea\u5df1\uff0c\u9677\u5165\u4e00\u79cd\u5947\u602a\u7684\u72b6\u6001\uff1a\u5fd9\uff0c\u4f46\u4e0d\u77e5\u9053\u5728\u5fd9\u4ec0\u4e48\uff1b\u7d2f\uff0c\u4f46\u8bf4\u4e0d\u51fa\u5728\u7d2f\u4ec0\u4e48\u3002\u6211\u4eec\u5728\u793e\u4ea4\u5a92\u4f53\u4e0a\u5237\u7740\u522b\u4eba\u7684\u751f\u6d3b\uff0c\u70b9\u8d5e\u3001\u8bc4\u8bba\uff0c\u5374\u5f88\u5c11\u505c\u4e0b\u6765\u95ee\u95ee\u81ea\u5df1\uff1a\u6211\u771f\u6b63\u60f3\u8981\u7684\u662f\u4ec0\u4e48\uff1f\u6211\u6b64\u523b\u7684\u611f\u53d7\u662f\u4ec0\u4e48\uff1f\n\n\u4e5f\u8bb8\u6211\u4eec\u9700\u8981\u7684\uff0c\u4e0d\u662f\u66f4\u591a\u7684\u65f6\u95f4\uff0c\u800c\u662f\u66f4\u6df1\u7684\u89c9\u77e5\u3002\n\n\u89c9\u77e5\u6b64\u523b\u7a97\u5916\u7684\u98ce\uff0c\u89c9\u77e5\u624b\u8fb9\u8fd9\u676f\u6c34\u7684\u6e29\u5ea6\uff0c\u89c9\u77e5\u5bf9\u9762\u90a3\u4e2a\u4eba\u8bf4\u8bdd\u65f6\u773c\u91cc\u95ea\u70c1\u7684\u5149\u3002\u89c9\u77e5\u672c\u8eab\u5c31\u662f\u4e00\u79cd\u56de\u5f52\u2014\u2014\u56de\u5230\u5f53\u4e0b\uff0c\u56de\u5230\u81ea\u5df1\uff0c\u56de\u5230\u751f\u547d\u6700\u672c\u771f\u7684\u72b6\u6001\u3002\n\n\u5e84\u5b50\u8bf4\uff1a\"\u5929\u5730\u6709\u5927\u7f8e\u800c\u4e0d\u8a00\u3002\"\u5927\u81ea\u7136\u4ece\u4e0d\u7126\u8651\uff0c\u82b1\u5f00\u82b1\u843d\uff0c\u4e91\u5377\u4e91\u8212\uff0c\u4e00\u5207\u90fd\u6309\u7167\u81ea\u5df1\u7684\u8282\u594f\u8fdb\u884c\u3002\u6625\u5929\u4e0d\u4f1a\u56e0\u4e3a\u51ac\u5929\u7684\u4e25\u5bd2\u800c\u7740\u6025\uff0c\u79cb\u5929\u4e5f\u4e0d\u4f1a\u56e0\u4e3a\u590f\u5929\u7684\u70ed\u70c8\u800c\u4f24\u611f\u3002\u5b83\u4eec\u53ea\u662f\u505a\u81ea\u5df1\uff0c\u5706\u6ee1\u800c\u81ea\u5728\u3002\n\n\u4e5f\u8bb8\u6211\u4eec\u4e5f\u53ef\u4ee5\u5b66\u7740\u8fd9\u6837\u6d3b\u7740\u3002\u4e0d\u6025\u4e0d\u8e81\uff0c\u4e0d\u5351\u4e0d\u4ea2\u3002\u63a5\u53d7\u65f6\u95f4\u7684\u6d41\u901d\uff0c\u63a5\u53d7\u751f\u547d\u7684\u65e0\u5e38\uff0c\u4f46\u4e0d\u56e0\u6b64\u800c\u653e\u5f03\u5bf9\u7f8e\u597d\u7684\u8ffd\u6c42\u3002\u5728\u5fd9\u788c\u4e2d\u7559\u4e00\u70b9\u7a7a\u767d\u7ed9\u81ea\u5df1\uff0c\u5728\u55a7\u56a3\u4e2d\u5b88\u4e00\u65b9\u5b81\u9759\u7ed9\u5fc3\u7075\u3002\n\n\u6700\u540e\uff0c\u6211\u60f3\u8bf4\u8bf4\u5173\u4e8e\u672a\u6765\u8fd9\u4ef6\u4e8b\u3002\n\n\u672a\u6765\u662f\u4e0d\u53ef\u77e5\u7684\uff0c\u8fd9\u662f\u786e\u5b9a\u7684\u3002\u6211\u4eec\u65e0\u6cd5\u9884\u6d4b\u660e\u5929\u4f1a\u53d1\u751f\u4ec0\u4e48\uff0c\u65e0\u6cd5\u4fdd\u8bc1\u52aa\u529b\u5c31\u4e00\u5b9a\u6709\u56de\u62a5\uff0c\u65e0\u6cd5\u627f\u8bfa\u6240\u7231\u7684\u4eba\u4f1a\u6c38\u8fdc\u966a\u4f34\u3002\u6b63\u56e0\u4e3a\u5982\u6b64\uff0c\u6bcf\u4e00\u4e2a\u5f53\u4e0b\u624d\u663e\u5f97\u683c\u5916\u73cd\u8d35\u3002\n\n\u4e0e\u5176\u7126\u8651\u672a\u6765\uff0c\u4e0d\u5982\u7528\u5fc3\u8fc7\u597d\u4eca\u5929\u3002\u628a\u8be5\u8bf4\u7684\u8bdd\u8bf4\u4e86\uff0c\u628a\u8be5\u505a\u7684\u4e8b\u505a\u4e86\uff0c\u628a\u8be5\u73cd\u60dc\u7684\u4eba\u597d\u597d\u73cd\u60dc\u3002\u4e0d\u662f\u56e0\u4e3a\u5bb3\u6015\u5931\u53bb\uff0c\u800c\u662f\u56e0\u4e3a\u61c2\u5f97\uff1a\u751f\u547d\u7684\u610f\u4e49\u4e0d\u5728\u4e8e\u957f\u5ea6\uff0c\u800c\u5728\u4e8e\u90a3\u4e9b\u771f\u6b63\u88ab\u611f\u53d7\u3001\u88ab\u6d3b\u8fc7\u7684\u77ac\u95f4\u3002\n\n\u65f6\u95f4\u7684\u6cb3\u6d41\u4f9d\u65e7\u5954\u6d8c\u5411\u524d\uff0c\u6211\u4eec\u65e0\u6cd5\u8ba9\u5b83\u505c\u7559\u3002\u4f46\u6211\u4eec\u53ef\u4ee5\u9009\u62e9\u2014\u2014\u9009\u62e9\u5728\u5cb8\u8fb9\u9a7b\u8db3\u65f6\uff0c\u597d\u597d\u770b\u770b\u8fd9\u6cb3\u6c34\u7684\u989c\u8272\uff1b\u9009\u62e9\u5728\u98ce\u8d77\u65f6\uff0c\u611f\u53d7\u53d1\u4e1d\u88ab\u5439\u8d77\u7684\u6e29\u67d4\uff1b\u9009\u62e9\u5728\u6b64\u523b\uff0c\u5728\u8fd9\u91cc\uff0c\u771f\u5b9e\u5730\u3001\u5b8c\u6574\u5730\u3001\u4e0d\u5e26\u9057\u61be\u5730\u6d3b\u7740\u3002\n\n\u8fd9\u4e5f\u8bb8\u5c31\u662f\u65f6\u95f4\u6559\u7ed9\u6211\u7684\u6700\u91cd\u8981\u7684\u4e00\u8bfe\uff1a**\u4e0d\u662f\u4e0e\u65f6\u95f4\u5bf9\u6297\uff0c\u800c\u662f\u4e0e\u65f6\u95f4\u548c\u89e3\u3002** \u63a5\u53d7\u5b83\u5e26\u8d70\u7684\uff0c\u611f\u6069\u5b83\u7559\u4e0b\u7684\uff0c\u7136\u540e\uff0c\u7ee7\u7eed\u5411\u524d\u8d70\u3002\n\n\u5e26\u7740\u8bb0\u5fc6\uff0c\u5e26\u7740\u7231\uff0c\u5e26\u7740\u4e00\u9897\u4ecd\u7136\u613f\u610f\u76f8\u4fe1\u7f8e\u597d\u7684\u5fc3\u3002",
