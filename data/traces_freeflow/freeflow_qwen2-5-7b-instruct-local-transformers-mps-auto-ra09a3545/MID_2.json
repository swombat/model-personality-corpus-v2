u65f6\u662f\u4e00\u4e2a\u9769\u547d\u6027\u7684\u89c2\u5ff5\u3002\u5b83\u4fc3\u8fdb\u4e86\u5bf9\u53e4\u5178\u6587\u5b66\u548c\u54f2\u5b66\u7684\u7814\u7a76\uff0c\u6fc0\u53d1\u4e86\u4eba\u4eec\u5bf9\u4e8e\u4e2a\u4eba\u5c0a\u4e25\u548c\u793e\u4f1a\u8d23\u4efb\u7684\u8ba4\u8bc6\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u9a6c\u4e01\u00b7\u8def\u5fb7\uff08Martin Luther\uff09\u9886\u5bfc\u7684\u5b97\u6559\u6539\u9769\u8fd0\u52a8\u6311\u6218\u4e86\u5929\u4e3b\u6559\u4f1a\u7684\u6743\u5a01\uff0c\u5f00\u542f\u4e86\u5b97\u6559\u81ea\u7531\u548c\u4e2a\u4eba\u4fe1\u4ef0\u9009\u62e9\u7684\u65b0\u7bc7\u7ae0\u3002\n\n\u6587\u827a\u590d\u5174\u4e0d\u4ec5\u662f\u4e00\u6bb5\u5386\u53f2\uff0c\u5b83\u4ee3\u8868\u4e86\u4e00\u79cd\u7cbe\u795e\u548c\u6587\u5316\u7684\u89c9\u9192\u3002\u5728\u8fd9\u4e2a\u65f6\u671f\uff0c\u4eba\u7c7b\u5f00\u59cb\u91cd\u65b0\u53d1\u73b0\u5e76\u63a2\u7d22\u81ea\u5df1\u4e0e\u4e16\u754c\u7684\u8054\u7cfb\uff0c\u8fd9\u79cd\u63a2\u7d22\u81f3\u4eca\u4ecd\u5728\u7ee7\u7eed\u3002\u65e0\u8bba\u662f\u827a\u672f\u7684\u521b\u4f5c\u3001\u79d1\u5b66\u7684\u63a2\u7d22\u8fd8\u662f\u601d\u60f3\u7684\u89e3\u653e\uff0c\u6587\u827a\u590d\u5174\u90fd\u4e3a\u6211\u4eec\u63d0\u4f9b\u4e86\u4e00\u4e2a\u5b9d\u8d35\u7684\u5386\u53f2\u89c6\u89d2\uff0c\u542f\u793a\u6211\u4eec\u5728\u4e0d\u65ad\u53d8\u5316\u7684\u4e16\u754c\u4e2d\u4fdd\u6301\u597d\u5947\u5fc3\u548c\u521b\u9020\u529b\u3002\n\n---\n\n\u901a\u8fc7\u8fd9\u6837\u7684\u53d9\u8ff0\uff0c\u6211\u4eec\u53ef\u4ee5\u770b\u5230\u6587\u827a\u590d\u5174\u4e0d\u4ec5\u4ec5\u662f\u4e00\u6bb5\u5386\u53f2\uff0c\u5b83\u4ee3\u8868\u4e86\u4e00\u79cd\u7cbe\u795e\u548c\u6587\u5316\u7684\u89c9\u9192\uff0c\u5f71\u54cd\u7740\u540e\u6765\u51e0\u767e\u5e74\u4e43\u81f3\u4eca\u5929\u7684\u4eba\u7c7b\u6587\u660e\u3002\u5e0c\u671b\u8fd9\u6bb5\u63cf\u8ff0\u80fd\u591f\u6fc0\u53d1\u4f60\u5bf9\u8fd9\u4e2a\u65f6\u671f\u7684\u5174\u8da3\uff0c\u4ee5\u53ca\u5bf9\u4eba\u7c7b\u5386\u53f2\u4e0a\u5176\u4ed6\u4f1f\u5927\u65f6\u523b\u7684\u597d\u5947\u5fc3\u3002"
