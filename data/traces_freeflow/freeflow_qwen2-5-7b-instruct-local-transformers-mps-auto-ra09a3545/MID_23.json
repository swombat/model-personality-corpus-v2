n\u518d\u8ba9\u6211\u4eec\u524d\u5f80\u4e00\u4e2a\u79d1\u6280\u5b9e\u9a8c\u5ba4\u3002\u79d1\u7814\u4eba\u5458\u5f20\u4f1f\u6b63\u5728\u7814\u7a76\u4e00\u79cd\u65b0\u578b\u6750\u6599\uff0c\u8fd9\u79cd\u6750\u6599\u5177\u6709\u81ea\u4fee\u590d\u529f\u80fd\uff0c\u80fd\u591f\u6709\u6548\u5ef6\u957f\u7535\u5b50\u4ea7\u54c1\u4f7f\u7528\u5bff\u547d\u3002\u4ed6\u5174\u594b\u5730\u8bf4\uff1a\u201c\u521b\u65b0\u4e0d\u662f\u4e3a\u4e86\u6807\u65b0\u7acb\u5f02\uff0c\u800c\u662f\u4e3a\u4e86\u66f4\u597d\u5730\u670d\u52a1\u4e8e\u793e\u4f1a\u3002\u6211\u76f8\u4fe1\u672a\u6765\u7684\u4e16\u754c\u4f1a\u56e0\u4e3a\u6211\u4eec\u7684\u52aa\u529b\u800c\u53d8\u5f97\u66f4\u52a0\u7f8e\u597d\u3002\u201d\u901a\u8fc7\u4e0d\u61c8\u7684\u52aa\u529b\uff0c\u5f20\u4f1f\u548c\u4ed6\u7684\u56e2\u961f\u7ec8\u4e8e\u53d6\u5f97\u4e86\u7a81\u7834\u6027\u8fdb\u5c55\uff0c\u4ed6\u4eec\u7684\u7814\u7a76\u6210\u679c\u6709\u671b\u5728\u672a\u6765\u51e0\u5e74\u5185\u5e94\u7528\u4e8e\u5b9e\u9645\u4ea7\u54c1\u4e2d\uff0c\u4e3a\u4eba\u4eec\u7684\u751f\u6d3b\u5e26\u6765\u4fbf\u5229\u3002\n\n\u6700\u540e\uff0c\u6211\u4eec\u6765\u5230\u4e00\u5ea7\u56fe\u4e66\u9986\u3002\u6587\u5b66\u4f5c\u5bb6\u5218\u6653\u6b63\u5728\u9605\u8bfb\u4e00\u672c\u5173\u4e8e\u5386\u53f2\u7684\u5c0f\u8bf4\uff0c\u5979\u6c89\u6d78\u5728\u4e66\u4e2d\u6240\u63cf\u8ff0\u7684\u90a3\u4e2a\u9065\u8fdc\u65f6\u4ee3\u3002\u5218\u6653\u8bf4\uff1a\u201c\u9605\u8bfb\u4e0d\u4ec5\u8ba9\u6211\u4e86\u89e3\u8fc7\u53bb\uff0c\u66f4\u91cd\u8981\u7684\u662f\u6fc0\u53d1\u6211\u5bf9\u672a\u6765\u7684\u60f3\u8c61\u3002\u6bcf\u4e00\u4e2a\u6545\u4e8b\u90fd\u662f\u4e00\u4e2a\u7a97\u53e3\uff0c\u8ba9\u6211\u4eec\u770b\u5230\u4e16\u754c\u7684\u591a\u6837\u6027\u3002\u201d\u5979\u5e0c\u671b\u901a\u8fc7\u81ea\u5df1\u7684\u6587\u5b57\uff0c\u8ba9\u66f4\u591a\u7684\u4eba\u611f\u53d7\u5230\u5386\u53f2\u7684\u9b45\u529b\uff0c\u6fc0\u53d1\u4ed6\u4eec\u5bf9\u4e8e\u672a\u77e5\u7684\u597d\u5947\u5fc3\u3002\n\n\u8fd9\u4e9b\u521b\u4f5c\u8005\u7684\u6545\u4e8b\u544a\u8bc9\u6211\u4eec\uff0c\u65e0\u8bba\u662f\u5728\u827a\u672f\u3001\u97f3\u4e50\u3001\u79d1\u5b66\u8fd8\u662f\u6587\u5b66\u9886\u57df\uff0c\u6bcf\u4e2a\u4eba\u90fd\u53ef\u4ee5\u6210\u4e3a\u521b\u9020\u8005\u3002\u53ea\u8981\u4fdd\u6301\u597d\u5947\u5fc3\uff0c\u52c7\u4e8e\u63a2\u7d22\uff0c\u5c31\u80fd\u5728\u5e73\u51e1\u4e2d\u53d1\u73b0\u4e0d\u51e1\uff0c\u5728\u6709\u9650\u4e2d\u521b\u9020\u65e0\u9650\u3002\u6b63\u5982\u90a3\u53e5\u53e4\u8001\u7684\u8c1a\u8bed\u6240\u8bf4\uff1a\u201c\u7075\u611f\u6765\u81ea\u751f\u6d3b\uff0c\u4f46\u9ad8\u4e8e\u751f\u6d3b\u5927\u9678\u98a8\u666f\u7684\u771f\u5be6\u63cf\u5eff\u3002\u201d\n\n\u8ba9\u6211\u4eec\u7ee7\u7eed\u524d\u884c\uff0c\u5728\u8fd9\u4e2a\u5145\u6ee1\u5947\u8ff9\u7684\u4e16\u754c\u91cc\uff0c\u4e0d\u65ad\u5bfb\u627e\u90a3\u4e9b\u9690\u85cf\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\u7684\u7f8e\u4e3d\u77ac\u95f4\u3002\u65e0\u8bba\u662f\u65e5\u51fa\u65f6\u5206\u7684\u7b2c\u4e00\u7f15\u9633\u5149\uff0c\u8fd8\u662f\u591c\u665a\u661f\u7a7a\u4e0b\u7684\u5b81\u9759\u601d\u8003\uff0c\u90fd\u662f\u503c\u5f97\u6211\u4eec\u73cd\u60dc\u7684\u7f8e\u597d\u65f6\u523b\u3002\u521b\u610f\u548c\u60f3\u8c61\u529b\u662f\u6211\u4eec\u6700\u5b9d\u8d35\u7684\u8d22\u5bcc\uff0c\u5b83\u4eec\u5f15\u9886\u6211\u4eec\u8d70\u5411\u66f4\u52a0\u707f\u70c2\u8f89\u714c\u7684\u672a\u6765\u3002"
